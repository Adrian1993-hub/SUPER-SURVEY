{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperSurvey",
  "version": "0.1.1",
  "identifier": "com.supersurvey.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SuperSurvey",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "copyright": "© SuperSurvey",
    "publisher": "SuperSurvey",
    "shortDescription": "Marine & petroleum quantity survey",
    "longDescription": "Offline-first marine and petroleum cargo & bunker quantity surveys: decimal-exact calculations (ASTM D1250 / API MPMS, COSTALD), defensible source comparisons (NOAD / LOP), and signable PDF / XLSX reports.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
